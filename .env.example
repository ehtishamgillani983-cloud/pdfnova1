# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Project Settings -> API
# NOTE: Must be the root Project URL (e.g. "https://your-project.supabase.co"), NOT the REST URL (/rest/v1)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role key should ONLY be used in backend/server environments, never in client bundles:
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- GOOGLE ANALYTICS & SEARCH CONSOLE ---
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GSC_VERIFICATION_TAG="google-site-verification=XXXXXXXXXXXXXXXXX"

# --- GOOGLE ADSENSE ---
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
VITE_ADSENSE_BANNER_SLOT_ID="1234567890"
VITE_ADSENSE_RECTANGLE_SLOT_ID="0987654321"

# --- BACKEND WORKER / PROCESSING SERVICE (Optional Microservice) ---
PDF_PROCESSING_WORKER_URL="https://api.pdfnova.com/v1"
